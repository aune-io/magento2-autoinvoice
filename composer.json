{
    "name": "aune-io/magento2-autoinvoice",
    "description": "Automatically invoice all complete orders in your Magento 2 store",
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "103.0.*",
        "magento/module-sales": "103.0.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "type": "magento2-module",
    "license": [
        "OSL-3.0"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Aune\\AutoInvoice\\": ""
        }
    }
}
